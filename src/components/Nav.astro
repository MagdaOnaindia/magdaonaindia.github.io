---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

// Anchor links go through / so they also work from case-study pages.
const links = [
  { href: '/#projects', label: 'Projects' },
  { href: '/#how-i-build', label: 'How I build' },
  { href: '/#about', label: 'About' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="nav">
  <div class="container nav-inner">
    <a href="/" class="brand" aria-label="Magdalena Onaindia — home">
      <Logo size={30} />
      <span class="brand-name">Magdalena Onaindia</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          links.map(({ href, label }) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="nav-actions">
      <button type="button" class="palette-trigger" aria-label="Open command palette (Ctrl+K)">
        <kbd>Ctrl</kbd><kbd>K</kbd>
      </button>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: var(--z-nav);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    height: 4rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
  }

  .brand:hover {
    color: var(--accent);
  }

  nav ul {
    display: flex;
    gap: var(--s-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--s-3);
    color: var(--ink);
    text-decoration: none;
    font-size: 0.9375rem;
  }

  nav a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 6px;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }

  .palette-trigger {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    min-height: 44px;
    padding: 0 var(--s-3);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--ink-muted);
    cursor: pointer;
  }

  .palette-trigger:hover {
    border-color: var(--accent);
    color: var(--ink);
  }

  .palette-trigger kbd {
    font-size: 0.75rem;
  }

  @media (max-width: 720px) {
    nav,
    .brand-name {
      display: none; /* short one-pager: sections are one scroll away */
    }
  }
</style>

<script>
  document.querySelector('.palette-trigger')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('palette:open'));
  });
</script>
