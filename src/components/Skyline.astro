---
// Line-art Bilbao: Artxanda + funicular · Iberdrola tower · Guggenheim · the ría · Puente Colgante.
// Three parallax layers (mouse X), day/night scenery bound to the theme, all honoring reduced-motion.
---

<div class="skyline" role="img" aria-label="Line-art skyline of Bilbao: Artxanda and its funicular, the Iberdrola tower, the Guggenheim, the ría and the Puente Colgante">
  <svg viewBox="0 0 1200 260" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" preserveAspectRatio="xMidYMax meet" aria-hidden="true">
    <!-- ============ back layer: hills + sky ============ -->
    <g class="layer" data-depth="0.2">
      <!-- Artxanda -->
      <path d="M0 200 C 70 130 150 108 230 150 C 290 182 340 196 400 200" />
      <!-- funicular track + cabin -->
      <path d="M120 178 L 208 132" stroke-width="1.5" />
      <g transform="translate(158 148) rotate(-27)">
        <rect x="-9" y="-8" width="18" height="11" rx="2" stroke-width="1.5"></rect>
      </g>
      <!-- day sky -->
      <g class="day-only">
        <circle cx="308" cy="56" r="16" stroke-width="1.75"></circle>
        <path d="M308 30v-6M308 88v-6M282 56h-6M340 56h-6M290 38l-4-4M330 78l-4-4M326 38l4-4M286 78l-4-4" stroke-width="1.5" />
        <path d="M700 52 q 9 -9 18 0 M718 52 q 9 -9 18 0" stroke-width="1.5" />
      </g>
      <!-- night sky -->
      <g class="night-only">
        <path d="M320 40 A 17 17 0 1 0 320 74 A 13.5 13.5 0 0 1 320 40 Z" stroke-width="1.75" />
        <circle class="star" cx="420" cy="42" r="1.6" fill="currentColor" stroke="none"></circle>
        <circle class="star" cx="530" cy="28" r="1.6" fill="currentColor" stroke="none"></circle>
        <circle class="star" cx="705" cy="48" r="1.6" fill="currentColor" stroke="none"></circle>
        <circle class="star" cx="840" cy="30" r="1.6" fill="currentColor" stroke="none"></circle>
        <circle class="star" cx="150" cy="60" r="1.6" fill="currentColor" stroke="none"></circle>
      </g>
    </g>

    <!-- ============ mid layer: buildings ============ -->
    <g class="layer" data-depth="0.5">
      <!-- Iberdrola tower -->
      <path d="M430 200 L 446 58 L 462 200" />
      <path d="M436 160 h20 M439 124 h14 M442 92 h8" stroke-width="1.25" />
      <g class="night-only">
        <rect class="window" x="443" y="103" width="4" height="6" fill="var(--accent)" stroke="none"></rect>
        <rect class="window" x="440" y="138" width="4" height="6" fill="var(--accent)" stroke="none"></rect>
        <rect class="window" x="448" y="172" width="4" height="6" fill="var(--accent)" stroke="none"></rect>
      </g>

      <!-- Guggenheim: overlapping titanium sheets -->
      <g class="guggenheim">
        <path d="M520 200 C 545 118 625 108 668 156 C 690 180 706 194 730 200" />
        <path d="M560 200 C 590 96 680 100 718 200" />
        <path d="M610 200 C 620 150 660 140 700 168" stroke-width="1.5" />
        <!-- atrium curl + mast -->
        <path d="M638 128 C 630 100 660 92 668 116 C 673 131 660 140 650 132" stroke-width="1.5" />
        <path d="M700 168 L 700 140 M 694 148 h12" stroke-width="1.25" />
        <g class="night-only">
          <rect class="window" x="600" y="168" width="5" height="5" fill="var(--accent)" stroke="none"></rect>
          <rect class="window" x="648" y="176" width="5" height="5" fill="var(--accent)" stroke="none"></rect>
        </g>
      </g>

      <!-- Puente Colgante -->
      <path d="M905 200 L 922 82 M 939 200 L 922 82" />
      <path d="M1123 200 L 1140 82 M 1157 200 L 1140 82" />
      <path d="M912 168 h22 M916 138 h14 M919 110 h8" stroke-width="1.25" />
      <path d="M1130 168 h22 M1134 138 h14 M1137 110 h8" stroke-width="1.25" />
      <path d="M922 82 H 1140" />
      <path d="M922 82 C 995 122 1067 122 1140 82" stroke-width="1.5" />
      <!-- hanging gondola -->
      <path d="M1031 111 L 1031 148" stroke-width="1.5" />
      <rect x="1009" y="148" width="44" height="15" rx="2" stroke-width="1.75"></rect>
      <g class="night-only">
        <rect class="window" x="1016" y="152" width="4" height="5" fill="var(--accent)" stroke="none"></rect>
        <rect class="window" x="1042" y="152" width="4" height="5" fill="var(--accent)" stroke="none"></rect>
      </g>
    </g>

    <!-- ============ front layer: the ría ============ -->
    <g class="layer ria" data-depth="1">
      <path d="M0 216 Q 40 211 80 216 T 160 216 T 240 216 T 320 216 T 400 216 T 480 216 T 560 216 T 640 216 T 720 216 T 800 216 T 880 216 T 960 216 T 1040 216 T 1120 216 T 1200 216" stroke-width="1.75" />
      <path d="M60 232 Q 100 227 140 232 T 220 232 T 300 232 T 380 232" stroke-width="1.5" stroke-dasharray="10 14" />
      <path d="M700 232 Q 740 227 780 232 T 860 232 T 940 232 T 1020 232 T 1100 232" stroke-width="1.5" stroke-dasharray="10 14" />
      <path d="M480 246 Q 520 241 560 246 T 640 246 T 720 246" stroke-width="1.25" stroke-dasharray="6 16" />
    </g>
  </svg>
</div>

<style>
  .skyline {
    color: var(--ink-muted);
    width: 100%;
    overflow: hidden;
  }

  .skyline svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .layer {
    transition: transform 0.15s linear;
  }

  /* day/night crossfade bound to theme */
  .day-only,
  .night-only {
    transition: opacity 0.6s ease;
  }

  :global([data-theme='light']) .night-only {
    opacity: 0;
  }

  :global([data-theme='dark']) .day-only {
    opacity: 0;
  }

  :global([data-theme='dark']) .star {
    animation: twinkle 3.5s ease-in-out infinite;
  }

  :global([data-theme='dark']) .star:nth-of-type(2) {
    animation-delay: 0.9s;
  }

  :global([data-theme='dark']) .star:nth-of-type(4) {
    animation-delay: 1.8s;
  }

  :global([data-theme='dark']) .window {
    animation: blink 6s ease-in-out infinite;
  }

  :global([data-theme='dark']) .window:nth-of-type(2n) {
    animation-delay: 2.4s;
  }

  @keyframes twinkle {
    50% {
      opacity: 0.25;
    }
  }

  @keyframes blink {
    0%,
    88%,
    100% {
      opacity: 1;
    }
    92%,
    96% {
      opacity: 0.15;
    }
  }

  /* command-palette easter egg: the Guggenheim does a wave */
  .guggenheim.wave {
    animation: gugg-wave 1.1s ease-in-out;
    transform-origin: 620px 200px;
  }

  @keyframes gugg-wave {
    25% {
      transform: translateY(-7px) rotate(-1deg);
    }
    55% {
      transform: translateY(3px) rotate(0.8deg);
    }
    80% {
      transform: translateY(-2px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .star,
    .window,
    .guggenheim.wave {
      animation: none !important;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.skyline');
  const layers = root?.querySelectorAll<SVGGElement>('.layer') ?? [];
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  let raf = 0;
  window.addEventListener('mousemove', (e) => {
    if (reduced.matches || !root) return;
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(() => {
      const x = (e.clientX / innerWidth - 0.5) * 2; // -1 .. 1
      layers.forEach((layer) => {
        const depth = Number(layer.dataset.depth ?? 0);
        layer.style.transform = `translateX(${(-x * 6 * depth).toFixed(2)}px)`;
      });
    });
  });

  window.addEventListener('skyline:wave', () => {
    if (reduced.matches) return;
    const g = root?.querySelector('.guggenheim');
    g?.classList.remove('wave');
    // reflow so the animation can retrigger
    void (g as HTMLElement | null)?.getBoundingClientRect();
    g?.classList.add('wave');
    setTimeout(() => g?.classList.remove('wave'), 1200);
  });
</script>
