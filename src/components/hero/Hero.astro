---
import Skyline from '../Skyline.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-copy">
    <p class="section-kicker">.net engineer → ai product builder</p>
    <h1 id="hero-title">
      <span lang="eu" title="“Hello” in Basque">Kaixo!</span> I'm Magdalena.
    </h1>
    <p class="hero-line">Software engineer turned AI product builder.</p>
    <p class="hero-diff">
      I ship real products with AI agents — and host them on my own hardware in
      <span lang="es">Bilbao</span>.
    </p>
    <div class="hero-ctas">
      <a class="btn btn-primary" href="#projects">See what I've built</a>
      <a class="btn btn-ghost" href="#contact">Get in touch</a>
    </div>
  </div>
  <Skyline />
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 92vh;
    min-height: 92dvh;
    padding-top: 6rem;
    gap: var(--s-8);
  }

  .hero-copy {
    width: 100%;
  }

  h1 {
    margin-bottom: var(--s-3);
  }

  h1 [lang='eu'] {
    color: var(--accent);
  }

  .hero-line {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    font-weight: 600;
    margin-bottom: var(--s-2);
  }

  .hero-diff {
    color: var(--ink-muted);
    font-size: 1.0625rem;
    margin-bottom: var(--s-6);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
</style>
