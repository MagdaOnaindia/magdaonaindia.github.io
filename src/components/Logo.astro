---
// "MO" monogram: the M is two mountain peaks (the hills around Bilbao),
// the O is an open titanium curve — the Guggenheim sheet — wrapping the M.
interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <!-- open O: titanium curve, gap at the lower left -->
  <path d="M18 5.2 A20 20 0 1 1 8.5 35" />
  <!-- M: two peaks -->
  <path d="M10 32 L17 16 L24 32 L31 16 L38 32" />
</svg>
